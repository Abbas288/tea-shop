{
  "name": "tea-shop",
  "version": "0.1.0",
  "private": true,
  "description": "A small tea webshop where you can order tea and track your order.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "1dv610-laboration-2": "github:rosa24-bth/1DV610-laboration-2#laboration-2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@lnu/eslint-config": "^2.0.17",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
