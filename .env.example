# Copy this file to .env for `npm start` and `npm run dev`.
# Never commit .env file.

PORT=3000
NODE_ENV=development
DB_CONNECTION_STRING=mongodb://localhost:27017/tea-shop

# The session cookie's name, and a long random secret that signs it.
SESSION_NAME=tea-shop.sid
SESSION_SECRET=change-me-to-a-long-random-string

# The shop's only admin. The server saves the password hashed when it starts.
ADMIN_EMAIL=admin@example.se
ADMIN_PASSWORD=change-me-to-at-least-10-characters
